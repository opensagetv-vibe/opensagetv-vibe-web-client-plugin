<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">
    <display-name>SageTV Web Player</display-name>

    <filter>
        <filter-name>securityHeaders</filter-name>
        <filter-class>org.opensagetv.webplayer.SecurityHeadersFilter</filter-class>
        <async-supported>true</async-supported>
    </filter>
    <filter-mapping>
        <filter-name>securityHeaders</filter-name>
        <url-pattern>/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
        <dispatcher>ASYNC</dispatcher>
    </filter-mapping>

    <servlet>
        <servlet-name>health</servlet-name>
        <servlet-class>org.opensagetv.webplayer.HealthServlet</servlet-class>
    </servlet>
    <servlet-mapping><servlet-name>health</servlet-name><url-pattern>/api/health</url-pattern></servlet-mapping>

    <servlet>
        <servlet-name>mediaInfo</servlet-name>
        <servlet-class>org.opensagetv.webplayer.MediaInfoServlet</servlet-class>
    </servlet>
    <servlet-mapping><servlet-name>mediaInfo</servlet-name><url-pattern>/api/media</url-pattern></servlet-mapping>

    <servlet>
        <servlet-name>discInfo</servlet-name>
        <servlet-class>org.opensagetv.webplayer.DiscInfoServlet</servlet-class>
    </servlet>
    <servlet-mapping><servlet-name>discInfo</servlet-name><url-pattern>/api/disc</url-pattern></servlet-mapping>

    <servlet>
        <servlet-name>recordings</servlet-name>
        <servlet-class>org.opensagetv.webplayer.RecordingsServlet</servlet-class>
    </servlet>
    <servlet-mapping><servlet-name>recordings</servlet-name><url-pattern>/api/recordings</url-pattern></servlet-mapping>


    <servlet>
        <servlet-name>guide</servlet-name>
        <servlet-class>org.opensagetv.webplayer.GuideServlet</servlet-class>
    </servlet>
    <servlet-mapping><servlet-name>guide</servlet-name><url-pattern>/api/guide</url-pattern></servlet-mapping>


    <servlet>
        <servlet-name>dvr</servlet-name>
        <servlet-class>org.opensagetv.webplayer.DvrServlet</servlet-class>
    </servlet>
    <servlet-mapping><servlet-name>dvr</servlet-name><url-pattern>/api/dvr</url-pattern></servlet-mapping>

    <servlet>
        <servlet-name>libraryAction</servlet-name>
        <servlet-class>org.opensagetv.webplayer.LibraryActionServlet</servlet-class>
    </servlet>
    <servlet-mapping><servlet-name>libraryAction</servlet-name><url-pattern>/api/library</url-pattern></servlet-mapping>

    <servlet>
        <servlet-name>favorites</servlet-name>
        <servlet-class>org.opensagetv.webplayer.FavoritesServlet</servlet-class>
    </servlet>
    <servlet-mapping><servlet-name>favorites</servlet-name><url-pattern>/api/favorites</url-pattern></servlet-mapping>

    <servlet>
        <servlet-name>history</servlet-name>
        <servlet-class>org.opensagetv.webplayer.HistoryServlet</servlet-class>
    </servlet>
    <servlet-mapping><servlet-name>history</servlet-name><url-pattern>/api/history</url-pattern></servlet-mapping>

    <servlet>
        <servlet-name>tuners</servlet-name>
        <servlet-class>org.opensagetv.webplayer.TunersServlet</servlet-class>
    </servlet>
    <servlet-mapping><servlet-name>tuners</servlet-name><url-pattern>/api/tuners</url-pattern></servlet-mapping>

    <servlet>
        <servlet-name>recordingOptions</servlet-name>
        <servlet-class>org.opensagetv.webplayer.RecordingOptionsServlet</servlet-class>
    </servlet>
    <servlet-mapping><servlet-name>recordingOptions</servlet-name><url-pattern>/api/recording-options</url-pattern></servlet-mapping>

    <servlet>
        <servlet-name>commercials</servlet-name>
        <servlet-class>org.opensagetv.webplayer.CommercialsServlet</servlet-class>
    </servlet>
    <servlet-mapping><servlet-name>commercials</servlet-name><url-pattern>/api/commercials</url-pattern></servlet-mapping>

    <servlet>
        <servlet-name>assetStatus</servlet-name>
        <servlet-class>org.opensagetv.webplayer.AssetStatusServlet</servlet-class>
    </servlet>
    <servlet-mapping><servlet-name>assetStatus</servlet-name><url-pattern>/api/assets</url-pattern></servlet-mapping>

    <servlet>
        <servlet-name>vendorAssets</servlet-name>
        <servlet-class>org.opensagetv.webplayer.VendorAssetServlet</servlet-class>
    </servlet>
    <servlet-mapping><servlet-name>vendorAssets</servlet-name><url-pattern>/vendor/*</url-pattern></servlet-mapping>

    <servlet>
        <servlet-name>transcoderStatus</servlet-name>
        <servlet-class>org.opensagetv.webplayer.TranscodeStatusServlet</servlet-class>
    </servlet>
    <servlet-mapping><servlet-name>transcoderStatus</servlet-name><url-pattern>/api/transcoder</url-pattern></servlet-mapping>

    <servlet>
        <servlet-name>stream</servlet-name>
        <servlet-class>org.opensagetv.webplayer.StreamServlet</servlet-class>
    </servlet>
    <servlet-mapping><servlet-name>stream</servlet-name><url-pattern>/stream</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>stream</servlet-name><url-pattern>/stream.ts</url-pattern></servlet-mapping>

    <servlet>
        <servlet-name>liveStream</servlet-name>
        <servlet-class>org.opensagetv.webplayer.LiveStreamServlet</servlet-class>
        <async-supported>true</async-supported>
    </servlet>
    <servlet-mapping><servlet-name>liveStream</servlet-name><url-pattern>/live.ts</url-pattern></servlet-mapping>


    <servlet>
        <servlet-name>hlsControl</servlet-name>
        <servlet-class>org.opensagetv.webplayer.HlsControlServlet</servlet-class>
    </servlet>
    <servlet-mapping><servlet-name>hlsControl</servlet-name><url-pattern>/api/hls</url-pattern></servlet-mapping>

    <servlet>
        <servlet-name>hlsFiles</servlet-name>
        <servlet-class>org.opensagetv.webplayer.HlsFileServlet</servlet-class>
    </servlet>
    <servlet-mapping><servlet-name>hlsFiles</servlet-name><url-pattern>/hls/*</url-pattern></servlet-mapping>

    <servlet>
        <servlet-name>transcode</servlet-name>
        <servlet-class>org.opensagetv.webplayer.TranscodeServlet</servlet-class>
    </servlet>
    <servlet-mapping><servlet-name>transcode</servlet-name><url-pattern>/transcode.mp4</url-pattern></servlet-mapping>


    <servlet>
        <servlet-name>miniClient</servlet-name>
        <servlet-class>org.opensagetv.webplayer.MiniClientServlet</servlet-class>
    </servlet>
    <servlet-mapping><servlet-name>miniClient</servlet-name><url-pattern>/api/miniclient</url-pattern></servlet-mapping>

    <servlet>
        <servlet-name>diagnosticSupport</servlet-name>
        <servlet-class>org.opensagetv.webplayer.DiagnosticSupportServlet</servlet-class>
    </servlet>
    <servlet-mapping><servlet-name>diagnosticSupport</servlet-name><url-pattern>/api/support</url-pattern></servlet-mapping>

    <servlet>
        <servlet-name>codecHlsTest</servlet-name>
        <servlet-class>org.opensagetv.webplayer.CodecHlsTestServlet</servlet-class>
    </servlet>
    <servlet-mapping><servlet-name>codecHlsTest</servlet-name><url-pattern>/api/codec-test</url-pattern></servlet-mapping>

    <servlet>
        <servlet-name>codecHlsTestMedia</servlet-name>
        <servlet-class>org.opensagetv.webplayer.CodecHlsTestMediaServlet</servlet-class>
    </servlet>
    <servlet-mapping><servlet-name>codecHlsTestMedia</servlet-name><url-pattern>/codec-test-media/*</url-pattern></servlet-mapping>

    <welcome-file-list><welcome-file>index.html</welcome-file></welcome-file-list>
  <servlet><servlet-name>continuous-stream</servlet-name><servlet-class>org.opensagetv.webplayer.ContinuousStreamServlet</servlet-class><async-supported>true</async-supported></servlet>
  <servlet-mapping><servlet-name>continuous-stream</servlet-name><url-pattern>/continuous/*</url-pattern></servlet-mapping>
  <servlet><servlet-name>caption-stream</servlet-name><servlet-class>org.opensagetv.webplayer.CaptionsServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>caption-stream</servlet-name><url-pattern>/api/captions</url-pattern></servlet-mapping>
  <servlet><servlet-name>subtitle-cue-stream</servlet-name><servlet-class>org.opensagetv.webplayer.SubtitleCueServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>subtitle-cue-stream</servlet-name><url-pattern>/api/subtitles</url-pattern></servlet-mapping>
</web-app>
