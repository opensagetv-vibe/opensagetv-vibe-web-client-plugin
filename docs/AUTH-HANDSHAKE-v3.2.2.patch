+            wrappedKey=get("CRYPTO_SYMMETRIC_KEY");check(wrappedKey.length==(bits+7)/8,"not a raw RSA ciphertext reply");
+            check(Arrays.equals(wrappedKey,get("CRYPTO_SYMMETRIC_KEY")),"repeated key request changed key");
